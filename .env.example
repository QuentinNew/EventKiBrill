# Bot token (Discord Developer Portal > your application > Bot > Reset Token)
DISCORD_TOKEN=your_token_here

# ID of the forum channel to watch (right-click the channel > Copy ID,
# with Developer Mode enabled in Discord settings)
FORUM_CHANNEL_ID=forum_channel_id_here

# Message sent in each new forum post
CONFIRMATION_MESSAGE="Pour confirmer votre présence, cliquez sur ✅ sur l'événement au dessus.\nSi vous ne participez pas, cliquez sur ❌ au dessus, vous ne serez plus notifié des messages"

# Embed card title and color (hex, without #)
EMBED_TITLE=📢 Nouvel événement
EMBED_COLOR=DE8900

# Optional: ID of the role to mention (ping) on every new forum post
# (right-click the role > Copy ID, with Developer Mode enabled)
# If not set, the bot pings @everyone instead
# MENTION_ROLE_ID=
